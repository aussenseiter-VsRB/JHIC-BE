# Supabase connection string (get this from Supabase Dashboard → Project Settings → Database)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: server port (default 8080)
PORT=8080

# Backblaze B2 credentials for image storage
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=jhic-berita-images

# MinIO for local S3-compatible storage (docker compose --profile local up)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# n8n webhook proxy (chatbot + nexxa-match)
N8N_BASE_URL=https://n8n-b0wow8osw0okkcwc0g0gog4o.dev.usbypkp.ac.id
N8N_CHAT_PATH=/webhook/d1b0712b-8783-46ee-8add-5a386132f460/chat
N8N_CHAT_USERNAME=
N8N_CHAT_PASSWORD=
N8N_NEXXA_PATH=/webhook/e44f0376-40ef-42f4-980b-ec38e8390592
N8N_NEXXA_SECRET=
N8N_TIMEOUT=115
AI_RATE_LIMIT=10
